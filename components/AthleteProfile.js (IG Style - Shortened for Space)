import { useState, useEffect } from 'react';
import { useRouter } from 'next/router';
import { FaHeart, FaComment, FaShare, FaBasketballBall } from 'react-icons/fa';
import { supabase } from '../lib/supabase';

export default function AthleteProfile() {
  const [profile, setProfile] = useState(null);
  const router = useRouter();
  const { id } = router.query;

  useEffect(() => {
    // Fetch profile from Supabase
    supabase.from('athletes').select('*').eq('id', id).single().then(({ data }) => setProfile(data));
  }, [id]);

  if (!profile) return <div>Loading...</div>;

  const feed = [ // Mock feed
    { caption: 'Dunk highlight!', likes: 234, media: 'https://source.unsplash.com/random/?basketball' },
    // Add more
  ];

  const PostCard = ({ post }) => (
    <div className="bg-gray-900 mb-4 rounded p-3">
      <p>{post.caption}</p>
      <img src={post.media} alt="" className="w-full h-64 object-cover" />
      <div className="flex gap-4 mt-2">
        <FaHeart className="text-red-500" /> {post.likes} likes
        <FaComment /> <FaShare />
      </div>
    </div>
  );

  return (
    <div className="min-h-screen bg-black text-white p-4">
      <div className="text-center mb-6">
        <img src={profile.photo || 'https://source.unsplash.com/random/?athlete'} className="w-24 h-24 rounded-full mx-auto" />
        <h1 className="text-2xl font-bold">{profile.name}</h1>
        <p className="text-gray-400">{profile.username}</p>
        <p className="text-gray-300">{profile.bio}</p>
        <FaBasketballBall className="mx-auto mt-4 text-3xl text-blue-400" />
      </div>
      <div className="space-y-4">
        {feed.map((post, i) => <PostCard key={i} post={post} />)}
      </div>
    </div>
  );
}